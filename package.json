{
  "name": "@qwen-code/qwen-code",
  "private": true,
  "version": "0.27.2",
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/cua-driver/typescript",
    "packages/channels/base",
    "packages/channels/telegram",
    "packages/channels/weixin",
    "packages/channels/dingtalk",
    "packages/channels/wecom",
    "packages/channels/feishu",
    "packages/channels/qqbot",
    "packages/channels/github",
    "packages/channels/dws",
    "packages/channels/email",
    "packages/channels/gitlab",
    "packages/channels/plugin-example",
    "integrations/external-context",
    "integrations/external-context-mem0",
    "integrations/test-failure-explorer",
    "integrations/generated-ui",
    "!packages/desktop",
    "!packages/live-host",
    "!packages/mobile-shell"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Null3nter/qwen-code-local.git"
  },
  "bugs": {
    "url": "https://github.com/Null3nter/qwen-code-local/issues"
  },
  "homepage": "https://github.com/Null3nter/qwen-code-local#readme",
  "config": {
    "sandboxImageUri": "ghcr.io/qwenlm/qwen-code:0.27.2"
  },
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node scripts/dev.js",
    "debug": "cross-env DEBUG=1 node --inspect-brk scripts/start.js",
    "build": "cross-env NODE_OPTIONS=\"--max-old-space-size=6144\" node scripts/build.js",
    "build:all": "npm run build && npm run build:sandbox && npm run build:vscode",
    "build:packages": "corepack pnpm -r run build",
    "build:sandbox": "node scripts/build_sandbox.js",
    "build:vscode": "node scripts/build_vscode_companion.js",
    "bundle": "npm run generate && node esbuild.config.js && node scripts/copy_bundle_assets.js",
    "generate": "node scripts/generate-git-commit-info.js",
    "test": "cross-env NODE_OPTIONS=\"--max-old-space-size=3072\" npm run test --workspaces --if-present",
    "test:ci": "npm run test:ci:workspaces && npm run test:scripts",
    "test:ci:workspaces": "cross-env NODE_OPTIONS=\"--max-old-space-size=3072\" npm run test:ci --workspaces --if-present --",
    "test:scripts": "npm run test:standalone:runtimes:ci && npm run test:scripts:unit --",
    "test:scripts:unit": "vitest run --config ./scripts/tests/vitest.config.ts",
    "test:standalone:runtimes": "node scripts/test-standalone-runtimes.mjs",
    "test:standalone:runtimes:ci": "node scripts/test-standalone-runtimes.mjs --ci",
    "test:e2e": "cross-env VERBOSE=true KEEP_OUTPUT=true npm run test:integration:sandbox:none",
    "lint": "eslint . --ext .ts,.tsx && eslint integration-tests",
    "lint:ci": "eslint . --ext .ts,.tsx --max-warnings 0 && eslint integration-tests --max-warnings 0",
    "format": "prettier --experimental-cli --write .",
    "typecheck": "npm run typecheck --workspaces --if-present && npm run typecheck:integration",
    "typecheck:integration": "tsc -p integration-tests/tsconfig.json --pretty false",
    "preflight": "npm run clean && corepack pnpm install --frozen-lockfile && npm run format && npm run lint:ci && npm run build && npm run typecheck && npm run test:ci && npm run check:serve-fast-path-bundle",
    "postinstall": "patch-package",
    "prepare": "node scripts/prepare.js",
    "clean": "node scripts/clean.js",
    "pre-commit": "node scripts/pre-commit.js"
  },
  "bin": {
    "qwen": "scripts/cli-entry.js"
  },
  "files": [
    "dist/",
    "scripts/cli-entry.js",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "ink": "7.0.3",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@qwen-code/acp-bridge": "file:packages/acp-bridge",
    "@qwen-code/channel-base": "file:packages/channels/base",
    "@qwen-code/qwen-code": "file:packages/cli",
    "@qwen-code/qwen-code-core": "file:packages/core",
    "@qwen-code/sdk": "file:packages/sdk-typescript",
    "@qwen-code/web-shell": "file:packages/web-shell",
    "@qwen-code/web-templates": "file:packages/web-templates",
    "@types/node": "20.19.1",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.0",
    "eslint": "^9.24.0",
    "prettier": "^3.5.3",
    "typescript-eslint": "^8.30.1",
    "vitest": "^3.2.4",
    "zod": "4.6.6"
  },
  "optionalDependencies": {
    "@lydell/node-pty": "1.2.0-beta.10",
    "@lydell/node-pty-darwin-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-darwin-x64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-linux-x64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-arm64": "1.2.0-beta.10",
    "@lydell/node-pty-win32-x64": "1.2.0-beta.10"
  },
  "overrides": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
